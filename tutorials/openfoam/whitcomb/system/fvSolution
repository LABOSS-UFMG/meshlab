FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "rho.*" { solver diagonal; }
    "p.*"
    {
        solver          PBiCGStab;
        preconditioner  DILU;

        tolerance       1e-8;
        relTol          0.01;
    }

    "(U|k|omega|h).*"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-10;
        relTol          0.1;
    }
}

PIMPLE
{
    transonic               yes;
    maxCo 0.2;
    maxDeltaT 5e-6;
    momentumPredictor       yes;
    nOuterCorrectors        2;
    nCorrectors             2;
    // Keep all 3000 iterations for convergence analysis.

    nNonOrthogonalCorrectors 1;
}

