FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          PBiCGStab;
        preconditioner  DILU;

        tolerance       1e-8;
        relTol          0.01;
    }

    "(U|k|omega|h)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-10;
        relTol          0.1;
    }
}

PIMPLE
{
    transonic               yes;
    momentumPredictor       yes;
    nOuterCorrectors        1;
    nCorrectors             1;
    // Keep all 3000 iterations for convergence analysis.

    nNonOrthogonalCorrectors 1;
}

relaxationFactors
{
    fields
    {
        p               0.3;
        rho             0.5;
    }

    equations
    {
        p               0.65;
        U               0.45;
        h               0.4;
        "(k|omega)"     0.5;
    }
}

