FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}

fluxScheme      Kurganov;

ddtSchemes
{
    default         localEuler;
}

gradSchemes
{
    default         Gauss linear;

    grad(U)         cellLimited Gauss linear 1;
}

divSchemes
{
    default         none;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default             linear;
    reconstruct(rho)    Minmod;
    reconstruct(U)      Minmod;
    reconstruct(T)      Minmod;

}

snGradSchemes
{
    default         corrected;
}

wallDist
{
    method          meshWave;
}

