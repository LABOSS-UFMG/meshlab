FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}

#include "../constant/caseParameters"

dimensions      [0 1 -1 0 0 0 0];
internalField   uniform $UAmbient;

boundaryField
{
    inlet
    {
        type            surfaceNormalFixedValue;
        refValue        uniform $normalUThroat;
    }
    "(outlet|ambient_top|ambient_inlet)"
    {
        type            pressureInletOutletVelocity;
        value           uniform $UAmbient;
    }
    "(spike|duct_top|duct_bottom|outer_lip|outer_casing)"
    {
        type            slip;
    }
    "wedge_(front|back)"
    {
        type            wedge;
    }
}
