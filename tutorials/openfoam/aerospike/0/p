FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}

#include "../constant/caseParameters"

dimensions      [1 -1 -2 0 0 0 0];
internalField   uniform $pAmbient;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform $pThroat;
    }
    outlet
    {
        type            waveTransmissive;
        field           p;
        psi             psi;
        gamma           $gamma;
        value           uniform $pAmbient;
    }
    "(ambient_top|ambient_inlet)"
    {
        type            totalPressure;
        p0              uniform $pAmbient;
        psi             psi;
        gamma           $gamma;
        value           uniform $pAmbient;
    }
    "(spike|duct_top|duct_bottom|outer_lip|outer_casing)"
    {
        type            zeroGradient;
    }
    "wedge_(front|back)"
    {
        type            wedge;
    }
}
