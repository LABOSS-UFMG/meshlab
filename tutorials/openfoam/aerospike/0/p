FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}

#include "include/initialConditions"

dimensions      [1 -1 -2 0 0 0 0];
internalField   uniform $pAmbient;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform $pInlet;
    }
    "(outlet|ambient_top|ambient_inlet)"
    {
        type            fixedValue;
        value           uniform $pAmbient;
    }
    "(spike|duct_inner|duct_outer|outer_lip|outer_casing)"
    {
        type            zeroGradient;
    }
    "wedge_(front|back)"
    {
        type            wedge;
    }
}
